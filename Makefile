.PHONY: sim synth clean

# Load the tools (Questa, Synopsys) in the same shell that runs each flow
SETUP = source $(abspath setup.sh)

# Run the simulation
sim:
	bash -lc '$(SETUP) && $(MAKE) -C sim sim'

# Run the synthesis sweep over all clock period
synth:
	bash -lc '$(SETUP) && $(MAKE) -C synth sweep'

# Remove everything generated by both flows
clean:
	$(MAKE) -C sim clean
	$(MAKE) -C synth clean